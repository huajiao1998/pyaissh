# pyaissh-mcp 凭据模板 —— 复制为同目录的 .env 后填值
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# 为什么凭据放这里、而不是 MCP 客户端配置的 env：
#   1) 配置里的 env 会在 spawn 时直接进入服务器进程环境 —— 一次工具没调用，
#      密码也已经在子进程内存里
#   2) 有些客户端会清洗环境变量（DSH 删除匹配 /KEY|PASSWORD|SECRET|TOKEN/i 的
#      名字与 DSH_*），放在 shell/系统环境里会被丢掉，只有写在配置 env 里才活
#   3) .env 由 CLI 在每次工具调用时才读取，进程环境从启动起不含密码
#
# .env 解析规则（与 CLI 一致）：
#   - 一行一个 KEY=VALUE；# 开头为注释行
#   - 值可用引号包裹：KEY="a # b"（引号内的 # 不当作注释）
#   - 未加引号时，只有 " #"（# 前有空格）才算行内注释：KEY=a#b 不会被截断
#   - 已存在的环境变量优先 —— .env 不覆盖真实环境变量
#   - 只读【脚本目录】的 .env（就是本目录）；工作目录的 .env 默认不加载
#     （供应链防护，需显式 PYAISSH_ALLOW_CWD_ENV=1 才启用并打 WARN）
#   - 文件编码 UTF-8（带 BOM 也会自动剥离）

# ── 默认登录凭据（不写 target 里的密码时用这套）─────────────────────────
# 密码认证（二者留空则用密钥或工具参数）
# PYAISSH_PASSWORD=<你的默认密码>
# 或者私钥路径（优先于密码）
# PYAISSH_KEY=<私钥文件绝对路径>
# 默认用户名与端口（可选）
# PYAISSH_USER=<默认用户名>
# PYAISSH_PORT=22

# ── sudo 提权（工具参数 sudo: true 时用）──────────────────────────────
# PYAISSH_SUDO_PASSWORD=<普通用户的 sudo 密码>

# ── 跳板机（可选）────────────────────────────────────────────────────
# PYAISSH_JUMP_PASSWORD=<跳板机密码>
# PYAISSH_JUMP_KEY=<跳板机私钥绝对路径>

# ── 主机别名：工具里写 target: "@名称" ───────────────────────────────
# 例：PYAISSH_HOST_PROD=<user>@<host>:<port>   →   target: "@PROD"
# PYAISSH_HOST_PROD=<user>@<主机>:<端口>

# ── 供应链防护开关（默认关闭，非必要不要开）──────────────────────────
# PYAISSH_ALLOW_CWD_ENV=1
