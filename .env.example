# ============================================================================
# pyaissh 配置样例（.env.example）
#
# 用法：复制本文件为 .env，与 pyaissh.py 放同一目录，按需填写即可：
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# 关键规则（完整细节见 docs/setup.md）：
#   1. 本文件（.env.example）不会被加载——只有文件名恰为 .env 才会被读；
#   2. 只有 pyaissh.py 同目录的 .env 会自动加载；项目工作目录的 .env 默认
#      不加载（供应链防护：防恶意仓库注入 PSSH_HOST_* 钓鱼 SSH）；
#   3. 环境变量优先于 .env（.env 不覆盖已存在的环境变量）；
#   4. .env 是明文文件：切勿提交进 git / 分享 / 打包，泄露=凭据泄露；
#   5. 安全建议：密码用环境变量或 .env，不要写进 --password 命令行参数
#      （进程列表 ps 可见）；敏感环境可用密钥认证（PSSH_KEY）。
# ============================================================================

# ---------------------------------------------------------------------------
# 一、全局默认（target 未单独指定时对所有主机生效）
# ---------------------------------------------------------------------------

# 默认用户名：target 写 host（无 user@）时使用
PSSH_USER=root

# 默认端口：target 未写 :port 且命令行未用 -p 时使用（默认 22）
PSSH_PORT=22

# 默认密码：target 未指定密码时使用
# 优先级：--key/PSSH_KEY > --password/PSSH_PASSWORD > 默认私钥 ~/.ssh/id_ed25519
PSSH_PASSWORD=改成你的密码

# 默认私钥【文件路径】（优先级高于密码；文件不存在直接报 auth_failed）
# PSSH_KEY=C:/Users/me/.ssh/id_ed25519
# PSSH_KEY=/home/me/.ssh/id_ed25519

# ---------------------------------------------------------------------------
# 二、主机别名（推荐用法：一个别名 = 一台主机全套配置）
# ---------------------------------------------------------------------------
# 格式：PSSH_HOST_<名称>=user@host[:port]
# 之后 target 写 @名称 即可引用：pyaissh test @prod
# 键名大小写不敏感：PSSH_HOST_PROD / pssh_host_prod / PSSH_host_prod 均可
# 别名可配专属凭据：PSSH_HOST_<名称>_PASSWORD / PSSH_HOST_<名称>_KEY
#   ——配了任一专属凭据后，该主机不再取全局 PSSH_KEY/PSSH_PASSWORD
#     （凭据完全由别名决定，防全局 key 抢先导致别名密码永远轮不到）；
#   ——专属 KEY 与 PASSWORD 同时配时 KEY 优先（密码被忽略，同全局规则）。

# 示例：生产机（密码认证）
PSSH_HOST_PROD=root@203.0.113.10:22
PSSH_HOST_PROD_PASSWORD=生产机密码

# 示例：测试机（密钥认证，非标准端口）
PSSH_HOST_TEST=deploy@198.51.100.7:2222
PSSH_HOST_TEST_KEY=/home/me/.ssh/test_id_ed25519

# 示例：别名不带密码（复用全局 PSSH_PASSWORD）
# PSSH_HOST_STAGING=root@203.0.113.20:22

# 示例：IPv6 主机（必须加方括号）
# PSSH_HOST_V6=root@[2001:db8::1]:22

# 用别名后的调用方式：
#   pyaissh test @prod
#   pyaissh exec @prod --cmd 'uname -a'
#   pyaissh upload @test --local ./app.jar --remote /opt/app/app.jar

# ---------------------------------------------------------------------------
# 三、跳板机（--jump 使用，可选）
# ---------------------------------------------------------------------------
# 调用时写 --jump user@host[:port]（也支持 @别名）；下面配默认跳板凭据：
# （注意：不存在 PSSH_JUMP_USER——跳板用户名回退用目标用户/-u/PSSH_USER）
# PSSH_JUMP_PASSWORD=跳板机密码（未配置时自动回退 PSSH_PASSWORD，v1.4.9 起）
# PSSH_JUMP_KEY=/home/me/.ssh/jump_id_ed25519（密钥无回落）

# ---------------------------------------------------------------------------
# 四、供应链开关（一般不需要动）
# ---------------------------------------------------------------------------
# 工作目录（cwd）的 .env 默认不加载。只有你信任当前工作目录时才设 1：
# PSSH_ALLOW_CWD_ENV=1

# ---------------------------------------------------------------------------
# 五、格式备忘（解析器行为，完整规则见 docs/setup.md）
# ---------------------------------------------------------------------------
# 行内注释：KEY=value # 注释（# 前必须有空格，KEY=a#b 不拆）
# 引号包裹：KEY="a # b"  值为 a # b（引号内 # 不拆；单双引号均可）
# 编码：UTF-8（带 BOM 也能读）
# 认证优先级：--key/PSSH_KEY > --password/PSSH_PASSWORD
#             > 默认私钥 ~/.ssh/id_ed25519 > ssh-agent 兜底
# 错误排查：完全无凭据时报 auth_failed，message 会提示缺哪个变量
