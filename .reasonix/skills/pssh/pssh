#!/usr/bin/env bash
# pssh - paramiko SSH 工具包装器（Git Bash / MSYS / Linux / macOS 通用）
# 定位与包装脚本同目录的 pssh.py（跟随符号链接），避免硬编码路径。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        # Windows (Git Bash)：禁用 MSYS 路径转换，避免 /tmp /opt 等远程路径
        # 被改成 Windows 路径；用 pwd -W 输出 Windows 风格路径，否则 Windows
        # 的 python 会把 /d/xxx 解析成 D:\d\xxx 而出错。
        export MSYS_NO_PATHCONV=1
        export MSYS2_ARG_CONV_EXCL="*"
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -W)"
        PY=python
        ;;
    *)
        # Linux / macOS：python 通常叫 python3
        PY=python3
        [ -x "$(command -v python3)" ] || PY=python
        ;;
esac

exec "$PY" "$SCRIPT_DIR/pssh.py" "$@"
